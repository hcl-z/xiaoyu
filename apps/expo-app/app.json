{
  "expo": {
    "name": "daily +",
    "slug": "daily-plus",
    "version": "1.0.5",
    "scheme": "dailyplus",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择打卡照片需要访问你的相册。",
          "cameraPermission": "拍摄打卡照片需要访问你的相机。"
        }
      ],
      "expo-router"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hclz.dailyplus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F7FB"
      },
      "package": "com.hclz.dailyplus",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "extra": {
      "router": {}
    },
    "owner": "hclz"
  }
}
