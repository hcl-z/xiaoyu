{
  "name": "ios-style-recipe-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm run dev:web",
    "build": "pnpm run build:web",
    "start": "pnpm run start:web",
    "lint": "pnpm run lint:web",
    "typecheck": "pnpm run typecheck:web",
    "dev:web": "pnpm --filter @recipe/web dev",
    "build:web": "pnpm --filter @recipe/web build",
    "start:web": "pnpm --filter @recipe/web start",
    "lint:web": "pnpm --filter @recipe/web lint",
    "typecheck:web": "pnpm --filter @recipe/web typecheck",
    "check": "pnpm run lint && pnpm run typecheck",
    "check:all": "pnpm -r --if-present lint && pnpm -r --if-present typecheck"
  }
}
