{
  "name": "daily-plus",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter expo-app start",
    "ios": "pnpm --filter expo-app ios",
    "android": "pnpm --filter expo-app android",
    "lint": "pnpm --filter expo-app lint",
    "typecheck": "pnpm --filter expo-app typecheck",
    "check": "pnpm --filter expo-app check",
    "check:all": "pnpm -r --if-present lint && pnpm -r --if-present typecheck",
    "release-android": "node scripts/release-android.mjs",
    "release-ios": "node scripts/release-ios.mjs"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  }
}
